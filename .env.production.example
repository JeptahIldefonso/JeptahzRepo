# ==============================================================================
# JeptahzRepo Production Environment Variables
# ==============================================================================
# Add these variables to your Vercel Project Settings:
# Settings > Environment Variables (Environment: Production)
# ==============================================================================

# 1. Canonical Production URL (Required)
# Use your production custom domain or Vercel default domain with https://
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# 2. Supabase Cloud Configuration (Recommended)
# Create a Supabase project at https://supabase.com
# Find these under: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. PostgreSQL Database Connection (Optional for direct pooling / Drizzle)
# Find under: Project Settings > Database > Connection String (Transaction pooler)
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
