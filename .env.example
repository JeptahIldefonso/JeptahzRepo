# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (PostgreSQL - for Drizzle ORM / direct pooling)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Studio Authentication (Supports either Argon2 hash OR plain passphrase)
# 1. Hashed password (recommended) - generate with: npm run hash-password
# ADMIN_PASSWORD_HASH="$argon2id$v=19$m=19456,t=2,p=1$..."
# 2. Or plain passkey
ADMIN_PASSPHRASE="your_secret_admin_passphrase_here"

# Session HMAC Secret (32+ byte random hex string - rotating this invalidates all sessions)
SESSION_SECRET="generate-a-random-32-byte-hex-string"

# Vercel Blob Storage Token (Automatically provided by Vercel in production)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# Firebase Server Credentials (Private Service Account)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# Firebase Client Configuration (Safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# --------------------------------------------------------------------------
# Live Website Publishing Engine (GitHub + Vercel Deployment Sync)
# --------------------------------------------------------------------------
# GitHub Personal Access Token (Fine-grained or classic with 'repo' / 'Contents: Read and write' scope)
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"
GITHUB_OWNER="JeptahIldefonso"
GITHUB_REPO="JeptahzRepo"
GITHUB_BRANCH="main"

# Vercel API Token for deployment tracking (Create at: https://vercel.com/account/tokens)
VERCEL_TOKEN="your_vercel_access_token_here"
VERCEL_PROJECT_ID="jeptahzrepo"
# VERCEL_TEAM_ID="team_xxx" # Optional, only if project belongs to a Vercel Team
